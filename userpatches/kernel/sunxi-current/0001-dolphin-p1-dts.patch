From 94dcb3a59e536127a7c2ce65d4faf410700b4e95 Mon Sep 17 00:00:00 2001
From: Dolphin-P1 <community@example.invalid>
Date: Mon, 28 Sep 2026 21:56:20 +0000
Subject: [PATCH] Add Dolphin-P1 DTS


diff --git a/arch/arm/boot/dts/allwinner/Makefile b/arch/arm/boot/dts/allwinner/Makefile
index 917abdb..b92dca9 100644
--- a/arch/arm/boot/dts/allwinner/Makefile
+++ b/arch/arm/boot/dts/allwinner/Makefile
@@ -1,5 +1,6 @@
 dtb-$(CONFIG_MACH_SUN8I_H3) += \
 	sun8i-h2-plus-libretech-all-h3-cc.dtb \
+	sun8i-h2-plus-dolphin-p1.dtb \
 	sun8i-h2-plus-orangepi-r1.dtb \
 	sun8i-h2-plus-orangepi-zero.dtb \
 	sun8i-h3-bananapi-m2-plus.dtb
diff --git a/arch/arm/boot/dts/allwinner/sun8i-h2-plus-dolphin-p1.dts b/arch/arm/boot/dts/allwinner/sun8i-h2-plus-dolphin-p1.dts
new file mode 100644
index 0000000..699f9ff
--- /dev/null
+++ b/arch/arm/boot/dts/allwinner/sun8i-h2-plus-dolphin-p1.dts
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device tree for Inphic H202A / Dolphin-P1.
+ *
+ * Stage 1 target:
+ *   U-Boot -> eMMC -> Linux -> eth0 -> SSH
+ *
+ * Hardware evidence:
+ *   - Allwinner H2+ / sun8i H3 family
+ *   - 512 MiB RAM
+ *   - Samsung 8 GB-class eMMC on MMC2, 8-bit, non-removable
+ *   - UART0 on PA4/PA5
+ *   - 100M Ethernet using the internal PHY
+ *   - PA15 is the board power LED
+ *   - A 32.768 kHz RTC crystal is confirmed present on the PCB
+ *
+ * USB0/OTG is intentionally disabled in Linux Stage 1. The USB0
+ * physical interface is reserved for the Allwinner BootROM FEL path
+ * used by Phoenix/sunxi-fel before Linux starts. Disabling the Linux
+ * OTG driver does not disable BootROM FEL.
+ *
+ * The image uses normal Armbian partitions. No Android/vendor
+ * partition layout or partitions= kernel argument is used.
+ */
+/dts-v1/;
+#include "sun8i-h3.dtsi"
+#include "sunxi-common-regulators.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+/ {
+	model = "Inphic H202A Dolphin-P1 (Allwinner H2+)";
+	compatible = "inphic,dolphin-p1", "allwinner,sun8i-h2-plus";
+	aliases {
+		serial0 = &uart0;
+		ethernet0 = &emac;
+	};
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x20000000>;
+	};
+	leds {
+		compatible = "gpio-leds";
+		led-power {
+			label = "dolphin:power";
+			gpios = <&pio 0 15 GPIO_ACTIVE_LOW>; /* PA15 */
+			default-state = "on";
+		};
+	};
+};
+/* UART0: debug console on PA4/PA5 */
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pa_pins>;
+	status = "okay";
+};
+/* eMMC on MMC2, 8-bit, non-removable.
+ *
+ * VCCQ/1.8V DDR is deliberately not forced: the physical eMMC VCCQ
+ * voltage must be measured before enabling mmc-ddr-1_8v.
+ */
+&mmc2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc2_8bit_pins>;
+	vmmc-supply = <&reg_vcc3v3>;
+	bus-width = <8>;
+	non-removable;
+	cap-mmc-hw-reset;
+	status = "okay";
+};
+/* 100M Ethernet with the internal PHY */
+&emac {
+	phy-handle = <&int_mii_phy>;
+	phy-mode = "mii";
+	allwinner,leds-active-low;
+	status = "okay";
+};
+/* USB PHY shared by the USB host controllers */
+&usbphy {
+	status = "okay";
+};
+/*
+ * The board has two visible USB-A connectors, but the PCB routing to
+ * H3 USB controller numbers has not yet been proven from a schematic.
+ * EHCI/OHCI 1 and 2 are therefore the Stage 1 host candidates.
+ */
+&ehci1 { status = "okay"; };
+&ohci1 { status = "okay"; };
+&ehci2 { status = "okay"; };
+&ohci2 { status = "okay"; };
+/* Unknown/internal USB controllers: defer until physical routing is confirmed. */
+&ehci0 { status = "disabled"; };
+&ohci0 { status = "disabled"; };
+&ehci3 { status = "disabled"; };
+&ohci3 { status = "disabled"; };
+/* USB0/OTG: reserved for BootROM FEL/Phoenix flashing; Linux OTG disabled. */
+&usb_otg {
+	status = "disabled";
+};
+/* Thermal + watchdog */
+&ths {
+	status = "okay";
+};
+&wdt0 {
+	status = "okay";
+};
+/* 32.768 kHz RTC crystal confirmed present on PCB; no backup battery. */
+&rtc {
+	status = "okay";
+};
+/* --- Stage 1 intentionally disabled --- */
+&mmc0 { status = "disabled"; }; /* no SD slot */
+&mmc1 { status = "disabled"; }; /* XR819 SDIO Wi-Fi, later */
+&de { status = "disabled"; };
+&tcon0 { status = "disabled"; };
+&hdmi { status = "disabled"; };
+&codec { status = "disabled"; };
+&ir { status = "disabled"; };
+&i2c0 { status = "disabled"; };
+&i2c1 { status = "disabled"; };
+&crypto { status = "disabled"; };
